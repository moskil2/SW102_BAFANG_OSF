+bafang_display_t* bafang_ui_bridge_get_display(void)
+{
+  return &g_bafang_display;
+}
+
+/*
+ * Two-way bridge between our telemetry (independent of the TSDZ2-oriented
+ * ui_vars_t/rt_processing() machinery) and the existing screen_main.c
+ * rendering, which only knows how to read/write ui_vars_t. Read direction
+ * (controller -> screen): speed/brake/battery/power. Write direction
+ * (buttons -> controller): main_button() in screen_main.c already changes
+ * ui_vars.ui8_assist_level on UP/DOWN - mirror it into g_bafang_display so
+ * the chosen level actually reaches the controller. Walk assist
+ * (ui_vars.ui8_walk_assist, set by a long DOWN press) takes priority when
+ * active, matching how the existing UI already treats it as an override.
+ */
+static void bafang_ui_bridge_update(void)
+{
+  /* Apply live settings (menu, see bafang_settings.h) before reading
+   * telemetry, so this tick's speed conversion/current calibration
+   * already reflect any change the user just made. */
+  g_bafang_display.wheel_circumference_m = BAFANG_WHEEL_CIRCUMFERENCE_M[g_bafang_settings.wheel_diameter_index];
+  bafang_display_set_current_calibration(&g_bafang_display, bafang_calibration_factor(g_bafang_settings.calibration_steps));
+
+  const bafang_telemetry_t* t = bafang_display_get_telemetry(&g_bafang_display);
+
+  ui_vars.ui16_wheel_speed_x10 = (uint16_t)(t->speed_kmh * 10.0f + 0.5f);
+  ui_vars.ui8_braking = t->brake_active;
+
+  /* Battery percentage: Standard (default) shows the controller's own
+   * raw byte, unmodified, same as always - untouched by the filter
+   * below, on request (voltage itself also stays raw/unfiltered, only
+   * the Precise percent gets smoothed). Precise recomputes it locally
+   * from our accurately-measured voltage instead - see bafang_settings.h
+   * and bafang_estimate_percent_from_voltage(). Guard: max<=min (e.g.
+   * user hasn't set real values yet, or entered them backwards) falls
+   * back to Standard rather than dividing by zero or showing garbage. */
+  /* filtered_percent/was_precise persist across calls (static, outer
+   * scope) so the filter can tell "just switched into Precise mode"
+   * (re-seed instantly) apart from "was already filtering last tick"
+   * (keep smoothing) - see the comment inside the branch below. */
+  static float filtered_percent;
+  static bool was_precise = false;
+
+  if (g_bafang_settings.battery_percent_precise &&
+      g_bafang_settings.battery_max_voltage_dv > g_bafang_settings.battery_min_voltage_dv)
+  {
+    /* Exponential moving average, ~8s time constant at this function's
+     * 100ms tick rate (alpha = dt/(tau+dt) = 0.1/8.1) - smooths out a
+     * few-second throttle-induced voltage sag so the Precise percent
+     * doesn't visibly jump around, while still fully catching up to a
+     * real, sustained voltage change within ~30-40s (see the
+     * 2026-09-16 battery-% notes for the worked example). Seeds
+     * filtered_percent instantly (skips the averaging) on the tick this
+     * mode is entered - boot, or switching Standard->Precise - so it
+     * never ramps up from a stale/zero value; every tick after that
+     * blends toward the new reading gradually. */
+    float instant_percent = bafang_estimate_percent_from_voltage(t->voltage_v,
