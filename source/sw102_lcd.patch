+        g_bafang_settings.battery_max_voltage_dv / 10.0f);
+
+    if (!was_precise)
+    {
+      filtered_percent = instant_percent;
+    }
+    else
+    {
+      const float alpha = 0.1f / 8.1f;
+      filtered_percent += alpha * (instant_percent - filtered_percent);
+    }
