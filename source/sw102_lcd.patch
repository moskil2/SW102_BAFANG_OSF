+
+/* Same as font_text(..., AlignLeft) but additionally clips off anything
+ * that would land left of left_clip, instead of only clipping at the
+ * screen's own x=0 edge (img_draw_clip's builtin behaviour) - used for
+ * the selected row's horizontal scroll, so overlong text scrolling left
+ * disappears at the menu's left-justification point (MENU_TEXT_X0) rather
+ * than sliding all the way to the physical screen edge. */
+static void font_text_clipped_left(const struct font *fnt, int x, int y, const char *txt, int left_clip)
+{
+	while(*txt) {
+		int cx, l;
+		l = font_getchar(fnt, *txt++, &cx);
+		if(l > 0) {
+			int dx = x, dcx = cx, dl = l;
