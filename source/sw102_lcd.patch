   $(COMMON_DIR)/src/eeprom.c \
@@ -318,9 +328,24 @@ erase:
 # Generate DFU package
 # Note: don't try the application-version-string option - it just dumbly pulls the string as a nubmer info the int32 in the settings (not what we want)
 # Note: we now set debug mode so users can move to prior revisions, not just new ones.
+#
+# The application .hex is padded with 0xFF up to a fixed 80KB footprint
+# (0x1B000-0x2F000, well clear of the bootloader at ~0x3AC00) BEFORE
+# packaging for OTA - real 2026-09-16 incident: a DFU update to a build
+# ~13KB SMALLER than the one already on the device left the device stuck
+# in the bootloader after a reported-successful BLE transfer (full SWD
+# reflash of the exact same image booted fine, isolating the fault to
+# the DFU path, not the firmware). We don't have the DFU bootloader's own
+# source (community prebuilt binary) to confirm it erases only as much
+# flash as the incoming image needs rather than the whole app region, but
+# padding removes the risk either way, entirely from our own build - no
+# hardware access needed for every future update. release_build's own
+# SWD image below is unaffected (OpenOCD mass_erase already wipes
+# everything unconditionally) - only the OTA package is padded.
 generate_dfu_package: $(OUTPUT_DIRECTORY)/nrf51822_sw102.hex
 	mkdir -p $(RELEASE_DIRECTORY)
-	$(NRFUTIL) pkg generate --application ./$(OUTPUT_DIRECTORY)/nrf51822_sw102.hex --key-file $(KEYFILE) --application-version $(VERSION_NUM) --hw-version 51 --sd-req 0x87 $(RELEASE_DIRECTORY)/sw102-otaupdate-xxx.zip
+	$(SREC_PATH)srec_cat $(OUTPUT_DIRECTORY)/nrf51822_sw102.hex -Intel -fill 0xFF 0x1B000 0x2F000 -o $(OUTPUT_DIRECTORY)/nrf51822_sw102_padded.hex -Intel
+	$(NRFUTIL) pkg generate --application ./$(OUTPUT_DIRECTORY)/nrf51822_sw102_padded.hex --key-file $(KEYFILE) --application-version $(VERSION_NUM) --hw-version 51 --sd-req 0x87 $(RELEASE_DIRECTORY)/sw102-otaupdate-xxx.zip
 
 # Generate a prebuilt bin file with bootloader apploand and valid app crc
 # per appendix 1 here: https://devzone.nordicsemi.com/nordic/nordic-blog/b/blog/posts/getting-started-with-nordics-secure-dfu-bootloader
