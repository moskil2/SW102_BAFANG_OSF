+/* Exchanges every UP event with its DOWN counterpart (and the ONOFF+UP/
+ * ONOFF+DOWN combos) - used while the screen is rotated 180 degrees, when
+ * the physical UP/DOWN buttons are upside down relative to the image. */
+static buttons_events_t swap_up_down(buttons_events_t ev)
+{
+	static const struct { uint32_t up, down; } pairs[] = {
+		{ UP_CLICK, DOWN_CLICK }, { UP_LONG_CLICK, DOWN_LONG_CLICK },
+		{ UP_PRESS, DOWN_PRESS }, { UP_RELEASE, DOWN_RELEASE },
+		{ ONOFFUP_LONG_CLICK, ONOFFDOWN_LONG_CLICK },
+	};
+	buttons_events_t out = ev;
+	for (unsigned i = 0; i < sizeof(pairs) / sizeof(pairs[0]); i++) {
+		out &= ~(pairs[i].up | pairs[i].down);
+		if (ev & pairs[i].up)
+			out |= pairs[i].down;
+		if (ev & pairs[i].down)
+			out |= pairs[i].up;
+	}
+	return out;
+}
